# Required — server will refuse to start without these
JWT_SECRET=
REFRESH_TOKEN_SECRET=
MONGO_DB_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recommended
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Comma-separated browser origins (CORS + Socket.IO). Defaults include
# famlink.care and localhost if unset.
# CORS_ORIGINS=https://famlink.care,https://www.famlink.care,https://admin.famylink.us,http://localhost:5173

# PhantomBuster webhook — requests rejected until this is set
PHANTOMBUSTER_WEBHOOK_SECRET=

# Optional hardening (falls back to JWT_SECRET if unset)
# UNSUBSCRIBE_SECRET=
# ANALYTICS_SALT_SECRET=
