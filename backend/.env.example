# Required — server will refuse to start without these
JWT_SECRET=
REFRESH_TOKEN_SECRET=
MONGO_DB_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recommended
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Optional EXTRA browser origins (CORS + Socket.IO). Merged with built-in
# defaults for famlink.care, famylink.us, findnannyshare.com, admin, localhost.
# CORS_ORIGINS=https://staging.example.com

# PhantomBuster / Make.com webhooks — requests rejected until a secret is set
# /phantombuster/webhook uses PHANTOMBUSTER_WEBHOOK_SECRET
# /leads/incoming and /leads/phantombuster accept WEBHOOK_SECRET or this fallback
PHANTOMBUSTER_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# Facebook lead pipeline (optional — only needed for PhantomBuster / Slack alerts)
OPENAI_API_KEY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_FB_GROUPS=
SLACK_WEBHOOK_CRAIGSLIST=
SLACK_WEBHOOK_NEXTDOOR=
SLACK_WEBHOOK_BPN=
SLACK_WEBHOOK_PEANUT=
AI_CONCURRENCY=8
AI_MAX_RETRIES=3
ENABLE_VISION_CHECK=false
MONGODB_URI=

# Optional hardening (falls back to JWT_SECRET if unset)
# UNSUBSCRIBE_SECRET=
# ANALYTICS_SALT_SECRET=
